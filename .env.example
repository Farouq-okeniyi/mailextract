# MailExtract Frontend Environment Configuration (Example Template)

# Backend API Base URL
VITE_API_URL=http://localhost:8000/api/v1

# Google OAuth Client Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_PROJECT_ID=your_google_project_id

# Google Cloud Console Audience / Test Users Management URL
VITE_GOOGLE_CLOUD_CONSOLE_URL=https://console.cloud.google.com/auth/audience?project=your_google_project_id

# Google Auth Integration Route Endpoint
VITE_GOOGLE_AUTH_ENDPOINT=/auth/google
